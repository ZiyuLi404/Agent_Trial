# Copy this file to .env and fill in your own keys.
# .env is gitignored — never commit real keys.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your real keys
#
# The scripts (run_trial.py / agentclinic_anchor_compare.py) call
# python-dotenv at startup, so anything set here is automatically
# available as an environment variable to the running process.

# DeepSeek (https://platform.deepseek.com) — required for deepseek-* models
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com) — required for gpt-* / o1-* models
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com) — required for claude-* models
ANTHROPIC_API_KEY=

# Replicate (https://replicate.com) — required for llama-* / mixtral-* models
REPLICATE_API_TOKEN=
