# ── Python ──
**/__pycache__/
*.pyc
*.out
.venv/

# ── Secrets — never commit ──
.env
.env.local
.env.*.local

# ── OS junk ──
.DS_Store
__MACOSX/

# ── results/ : 两层规则 ──
# 重的、可再跑出来的数据 → 忽略（原始 case 数据 / 运行日志 / LLM 缓存 / embedding 向量 等）
results/**/*.json
results/**/*.jsonl
results/**/*.npz
results/**/*.pdf
results/**/*.log
results/**/logs/
results/**/transcripts/
# 训练好的模型权重（可再训练，体积大）→ 忽略
results/**/*.safetensors
results/**/*.bin
results/**/best_model/
# 小而宝贵的最终结论（相似度矩阵 / 散度 / summary 等 .csv/.txt）默认入库，不在此忽略。

# ── 归档的可再生产物（png/pptx/zip 等，留盘不入库）──
generated_outputs/

# ── 顶层运行日志（旧位置，逐步迁入 results/）──
trial_log.jsonl
deployment_log.jsonl

*.csv
*.json
*.claude
*.sh